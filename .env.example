# =============================================================================
# Eyes-MCP — environment configuration
# Copy to .env and edit. All values shown are defaults except secret keys.
# =============================================================================

# --- HTTP server -------------------------------------------------------------
# Bind address for the MCP HTTP transport. 0.0.0.0 inside Docker.
EYES_HTTP_HOST=0.0.0.0
# Port for /health and /mcp endpoints.
EYES_HTTP_PORT=8787

# --- Logging -----------------------------------------------------------------
# winston level: error | warn | info | http | verbose | debug | silly
EYES_LOG_LEVEL=info

# --- LLM (main agent only) ---------------------------------------------------
# Optional. If unset, server runs in heuristic-only mode (no synthesis,
# raw chunks returned). Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Model name served by the Gemini-compatible endpoint (Gemma 4 31B).
GEMINI_MODEL=gemma-4-31b-it
# API base (override only if you proxy Google AI Studio).
GEMINI_BASE_URL=https://generativelanguage.googleapis.com

# --- Internal services (Docker DNS) ------------------------------------------
# SearXNG endpoint. Inside compose, this is the searxng service on port 8080.
SEARXNG_URL=http://searxng:8080
# Crawl4AI REST endpoint. Inside compose, this is the crawl4ai service on port 11235.
CRAWL4AI_URL=http://crawl4ai:11235

# --- Optional source auth ----------------------------------------------------
# GitHub PAT bumps REST rate limit from 60/hr to 5000/hr. Scopes: public_repo.
GITHUB_TOKEN=
# Reddit PRAW credentials. Both required if used.
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=eyes-mcp/0.1

# --- Runtime knobs -----------------------------------------------------------
# Where sub-agents write raw artifacts (must be a shared volume in compose).
EYES_DATA_DIR=/data
# Max shards per request. Hard cap 20.
EYES_MAX_SHARDS=5
# Max refinement iterations. Hard cap 5.
EYES_MAX_ITERATIONS=2
# Token budget for the main agent's context window per request.
EYES_TOKEN_BUDGET=80000
# Wall-clock budget per request, seconds.
EYES_TIME_BUDGET_SEC=120
