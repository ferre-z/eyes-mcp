# =============================================================================
# Eyes-MCP — environment configuration
# Copy to .env and edit. All values shown are defaults except secret keys.
# =============================================================================

# --- HTTP server -------------------------------------------------------------
# Bind address for the MCP HTTP transport. 0.0.0.0 inside Docker.
EYES_HTTP_HOST=0.0.0.0
# Port for /health and /mcp endpoints.
EYES_HTTP_PORT=8787

# --- Logging -----------------------------------------------------------------
# winston level: error | warn | info | http | verbose | debug | silly
EYES_LOG_LEVEL=info

# --- LLM provider (main agent only) -----------------------------------------
# Optional. If unset, server runs in heuristic-only mode (no synthesis,
# raw chunks returned).
#
# Two providers are wired:
#   google-ai-studio  - Google's AI Studio, OpenAI-compatible endpoint.
#                       Get a key at https://aistudio.google.com/apikey
#                       Free models include Gemma 4 31B, Gemma 3 27B/9B,
#                       Gemini 2.5 Flash, Gemini 2.5 Flash Lite.
#   openrouter        - OpenRouter.ai free tier. Many open models.
#                       Get a key at https://openrouter.ai/keys
#                       Free models include Llama 3.3 70B, Qwen 2.5 72B,
#                       DeepSeek V3, Mistral Small 3.1, Gemma 3 27B.
#
# Pick one and set its key. EYES_PROVIDER switches which one is active.

# Which provider to use. One of: google-ai-studio | openrouter
EYES_PROVIDER=google-ai-studio
# Model id for the active provider. See `eyes models list` for the catalog.
EYES_MODEL=gemma-4-31b-it

# Google AI Studio key. Get one at https://aistudio.google.com/apikey
GOOGLE_AI_STUDIO_API_KEY=
# OpenRouter key. Get one at https://openrouter.ai/keys
OPENROUTER_API_KEY=
# Legacy back-compat: the old GEMINI_API_KEY still works and maps onto
# GOOGLE_AI_STUDIO_API_KEY. Set only if you haven't migrated.
# GEMINI_API_KEY=

# --- Internal services (Docker DNS) ------------------------------------------
# SearXNG endpoint. Inside compose, this is the searxng service on port 8080.
SEARXNG_URL=http://searxng:8080
# Crawl4AI REST endpoint. Inside compose, this is the crawl4ai service on port 11235.
CRAWL4AI_URL=http://crawl4ai:11235

# --- Optional source auth ----------------------------------------------------
# GitHub PAT bumps REST rate limit from 60/hr to 5000/hr. Scopes: public_repo.
GITHUB_TOKEN=
# Reddit PRAW credentials. Both required if used.
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=eyes-mcp/0.1

# --- Runtime knobs -----------------------------------------------------------
# Where sub-agents write raw artifacts (must be a shared volume in compose).
EYES_DATA_DIR=/data
# Max shards per request. Hard cap 20.
EYES_MAX_SHARDS=5
# Max refinement iterations. Hard cap 5.
EYES_MAX_ITERATIONS=2
# Token budget for the main agent's context window per request.
EYES_TOKEN_BUDGET=80000
# Wall-clock budget per request, seconds.
EYES_TIME_BUDGET_SEC=120
